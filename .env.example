# Copy to .env. Never commit .env or API keys.
YOUTUBE_API_KEY=
# Set a strong random token before making the server reachable by other people.
APP_ACCESS_TOKEN=
DATABASE_PATH=data/planner.sqlite3
MAX_LIVE_RUNS_PER_DAY=20
# Optional creative drafting, only in LIVE mode. Leave blank for template output.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
